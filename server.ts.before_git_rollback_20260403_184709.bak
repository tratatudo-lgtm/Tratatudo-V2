  app.patch("/api/admin/tickets/:id/status", requireAdminSession, async (req: any, res) => {
    const { id } = req.params;
    const { status } = req.body;
    const { data: ticket } = await supabase.from("tickets").update({ status }).eq("id", id).select().single();
    if (status === 'resolvido' && ticket) {
      await sendWhatsAppNotification(ticket.client_id, ticket.phone_e164, `O seu ticket #${ticket.tracking_code} foi resolvido!`);
    }
    res.json({ ok: true, ticket });
  });

  // --- Travel Orders ---
  app.get("/api/admin/travel/orders", requireAdminSession, async (req: any, res) => {
    try {
      const { client_id, payment_status, sales_status, destination, search } = req.query;
      let query = supabase.from("travel_orders")
        .select("*, client:clients(company_name)")
        .order("created_at", { ascending: false });

      query = applyAdminScope(query, req);

      if (client_id) query = query.eq("client_id", client_id);
      if (payment_status) query = query.eq("payment_status", payment_status);
      if (sales_status) query = query.eq("sales_status", sales_status);
      if (destination) query = query.ilike("destination", `%${destination}%`);
      
      if (search) {
        query = query.or(`tracking_code.ilike.%${search}%,order_code.ilike.%${search}%,customer_name.ilike.%${search}%,destination.ilike.%${search}%`);
      }

      const { data: orders, error } = await query;
      if (error) throw error;

      res.json({ ok: true, orders: orders?.map(o => ({ ...o, company_name: (o.client as any)?.company_name })) });
    } catch (err: any) {
      res.status(500).json({ ok: false, error: err.message });
    }
  });

  app.get("/api/admin/travel/orders/:id", requireAdminSession, async (req: any, res) => {
    try {
      const { id } = req.params;
      let query = supabase.from("travel_orders")
        .select("*, client:clients(company_name), ticket:tickets(*)")
        .eq("id", id);

      query = applyAdminScope(query, req);

      const { data: order, error } = await query.single();
      if (error) throw error;

      res.json({ ok: true, order: { ...order, company_name: (order.client as any)?.company_name } });
    } catch (err: any) {
      res.status(500).json({ ok: false, error: err.message });
    }
  });

  app.post("/api/admin/travel/orders", requireAdminSession, async (req: any, res) => {
    try {
      const data = req.body;
      
      if (req.adminScope === "client" && data.client_id !== req.adminClientId) {
        return res.status(403).json({ ok: false, error: "Não tem permissão para criar pedidos para este cliente." });
      }

      if (data.amount_due === undefined || data.amount_due === null) {
        data.amount_due = (data.total_amount || 0) - (data.amount_paid || 0);
      }

      const { data: order, error } = await supabase.from("travel_orders").insert(data).select().single();
      if (error) throw error;

      res.json({ ok: true, order });
    } catch (err: any) {
      res.status(500).json({ ok: false, error: err.message });
    }
  });

