      if (effectiveClientId) {
        clientsQuery = clientsQuery.eq("id", effectiveClientId);
        messagesQuery = messagesQuery.eq("client_id", effectiveClientId);
        instancesQuery = instancesQuery.eq("client_id", effectiveClientId);
      }

      const [
        { data: clients, error: clientsError },
        { data: messages, error: messagesError },
        { data: instances, error: instancesError }
      ] = await Promise.all([
        clientsQuery,
        messagesQuery,
        instancesQuery
      ]);

      if (clientsError) throw clientsError;
      if (messagesError) throw messagesError;
      if (instancesError) throw instancesError;

      const total_clients = clients?.length || 0;
      const active_clients = clients?.filter((c: any) => String(c.status || "").toLowerCase() === "active").length || 0;
      const trial_clients = clients?.filter((c: any) => String(c.status || "").toLowerCase() === "trial").length || 0;
      const total_messages_24h = messages?.filter((m: any) => new Date(m.created_at) >= last24h).length || 0;
      const active_instances = instances?.filter((i: any) => ["open", "online", "connected"].includes(String(i.status || "").toLowerCase())).length || 0;

      const messages_chart = [];
      const clients_chart = [];

      for (let i = 6; i >= 0; i--) {
        const dayStart = new Date(now);
        dayStart.setHours(0, 0, 0, 0);
        dayStart.setDate(dayStart.getDate() - i);

        const dayEnd = new Date(dayStart);
        dayEnd.setDate(dayEnd.getDate() + 1);

        const label = dayStart.toLocaleDateString("pt-PT", { day: "2-digit", month: "2-digit" });

        const msgCount = messages?.filter((m: any) => {
          const d = new Date(m.created_at);
          return d >= dayStart && d < dayEnd;
        }).length || 0;

        const clientCount = clients?.filter((c: any) => {
          const d = new Date(c.created_at);
          return d >= dayStart && d < dayEnd;
        }).length || 0;

        messages_chart.push({ date: label, count: msgCount });
        clients_chart.push({ date: label, count: clientCount });
      }

      return res.json({
        total_clients,
        active_clients,
        trial_clients,
        total_messages_24h,
        active_instances,
        system_health: 100,
        messages_chart,
        clients_chart
      });
    } catch (err: any) {
      console.error("[ADMIN DASHBOARD STATS ERROR]", err);
