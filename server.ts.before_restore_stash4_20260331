        awaitingPaymentOrders: orders?.filter(o => o.sales_status === 'awaiting_payment').length || 0,
        confirmedOrders: orders?.filter(o => o.sales_status === 'confirmed').length || 0,
        completedOrders: orders?.filter(o => o.sales_status === 'completed').length || 0,
        cancelledOrders: orders?.filter(o => o.sales_status === 'cancelled').length || 0,
        
        pendingPayments: payments?.filter(p => p.status === 'pending').length || 0,
        paidPayments: payments?.filter(p => p.status === 'paid').length || 0,
        
        partialOrders: orders?.filter(o => o.payment_status === 'partial').length || 0,
        
        totalPaidAmount: payments?.filter(p => p.status === 'paid').reduce((acc, p) => acc + (p.amount || 0), 0) || 0,
        totalOutstandingAmount: orders?.reduce((acc, o) => acc + (o.amount_due || 0), 0) || 0,
        
        pixPayments: payments?.filter(p => p.payment_method === 'pix').length || 0,
        cardPayments: payments?.filter(p => p.payment_method === 'credit_card' || p.payment_method === 'debit_card').length || 0,
        installmentPayments: payments?.filter(p => p.payment_type === 'installment').length || 0,
        boletoPayments: payments?.filter(p => p.payment_method === 'boleto').length || 0
      };

      res.json({ ok: true, stats });
    } catch (err: any) {
      res.status(500).json({ ok: false, error: err.message });
    }
  });

  // --- Client Travel Data ---
