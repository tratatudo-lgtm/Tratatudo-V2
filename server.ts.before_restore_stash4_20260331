      const now = new Date();
      const last24h = new Date(now.getTime() - 24 * 60 * 60 * 1000);
      const last7d = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);

      let clientsQuery = supabase.from("clients").select("id, status, created_at").order("created_at", { ascending: true });
      let messagesQuery = supabase.from("wa_messages").select("id, created_at, client_id").gte("created_at", last7d.toISOString()).order("created_at", { ascending: true });
